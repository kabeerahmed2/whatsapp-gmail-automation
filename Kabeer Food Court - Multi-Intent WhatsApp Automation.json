    {
      "parameters": {
        "jsCode": "// Format rows fetched from Inventory sheet into a clean WhatsApp Markdown message\nconst items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{\n    json: {\n      output: \"🍔 *KABEER FOOD COURT MENU* 🍕\\n\\nOur menu is currently updating. Please check back in a few minutes or send us your query!\"\n    }\n  }];\n}\n\n// Group by category\nconst categorized = {};\nitems.forEach(item => {\n  const row = item.json;\n  const cat = row.Category || row.category || 'Specialties';\n  if (!categorized[cat]) categorized[cat] = [];\n  categorized[cat].push(row);\n});\n\nlet menuText = \"🍔 *WELCOME TO KABEER FOOD COURT MENU* 🍕\\n\";\nmenuText += \"📍 Karachi, Pakistan | ⏰ 12:00 PM - 2:00 AM\\n\";\nmenuText += \"━━━━━━━━━━━━━━━━━━━━━━\\n\\n\";\n\nfor (const [cat, catItems] of Object.entries(categorized)) {\n  menuText += `📌 *${cat.toUpperCase()}*\\n`;\n  catItems.forEach(i => {\n    const name = i['Dish Name'] || i['Item Name'] || i.Item || i.name || 'Delicious Item';\n    const price = i['Price (PKR)'] || i.Price || i.price || 'N/A';\n    const avail = i.Availability || i.Status || i.status || 'Available';\n    const stockIcon = (avail.toLowerCase().includes('out') || avail.toLowerCase().includes('no')) ? '❌ [Out of Stock]' : '✅';\n    \n    menuText += `• *${name}* - *PKR ${price}* ${stockIcon}\\n`;\n  });\n  menuText += \"\\n\";\n}\n\nmenuText += \"━━━━━━━━━━━━━━━━━━━━━━\\n\";\nmenuText += \"🛒 *To place an order*, simply reply with your item choices & delivery address!\\n\";\nmenuText += \"💡 Example: _I want to order 2 Zinger Burgers and 1 Cold Drink to Gulshan Block 5._\";\n\nreturn [{\n  json: {\n    output: menuText\n  }\n}];"
      },
      "id": "1ea5a12d-17c6-431d-adc6-2325db16e378",
      "name": "Format Menu Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
